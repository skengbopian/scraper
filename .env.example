# Copy to .env and fill locally. NEVER commit .env. All personal-data services must be EU-region.

# --- Core ---
NODE_ENV=development
# Testing alpha ONLY (ADR-028): serves ONE fixture identity + simulated transitions. The flag
# refuses to activate under NODE_ENV=production. Never set in any deployed environment.
SCRAPER_DEV_FIXTURES=1
PORT=3900
SCRAPER_REPOSITORY=memory          # memory (standalone alpha) | prisma (Postgres via packages/db)
SCRAPER_SCHEDULER=                 # pgboss (durable Frist timers; needs prisma + apps/worker) | empty                          # :3000 belongs to the main Next.js Scraper web app on dev machines
DATABASE_URL=postgresql://scraper:scraper@localhost:5432/scraper
OBJECT_STORE_ENDPOINT=            # S3-compatible, EU region (e.g. Scaleway fr-par / AWS eu-central-1)
OBJECT_STORE_BUCKET=scraper-evidence-eu
OBJECT_STORE_REGION=eu-central-1

# --- Model provider (EU inference ONLY for personal data) ---
MODEL_PROVIDER=stub                # stub | mistral-eu | azure-openai-eu | selfhost
MODEL_REGION=eu
MODEL_API_KEY=

# --- Identity verification (bank-ident / eID) ---
IDENTITY_PROVIDER=stub             # stub | idnow | nect | postident-eid
IDENTITY_API_KEY=

# --- Qualified electronic signature + timestamp (eIDAS QTSP) ---
QES_PROVIDER=stub
QTSP_ENDPOINT=

# --- Postal / hybrid mail ---
POSTAL_PROVIDER=stub               # stub | letterxpress | pingen
POSTAL_API_KEY=
INBOUND_MAIL_PROVIDER=stub         # scanning of postal replies (e.g. Caya/Dropscan) — later

# --- Email (aligned SPF/DKIM/DMARC for legal requests) ---
MAILER_PROVIDER=stub
MAILER_SENDING_DOMAIN=
MAILER_DKIM_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=

# --- Workflow engine ---
WORKFLOW_ENGINE=bullmq             # bullmq (M0/M1) | temporal
TEMPORAL_ADDRESS=
REDIS_URL=redis://localhost:6379

# --- Real providers (contract-gated, ADR §4; adapters in apps/worker/src/providers) ---
LETTERXPRESS_USER=
LETTERXPRESS_APIKEY=
LETTERXPRESS_MODE=sandbox
QTSP_TOKEN=                        # Openapi/InfoCert qualified timestamps
POSTIDENT_CLIENT_ID=
POSTIDENT_PASSWORD=
