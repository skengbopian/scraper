// Prisma schema — docs/03-data-model.md is normative; this is its implementation.
//
// Several invariants here cannot be expressed in Prisma's DSL and are enforced by SQL in
// migrations/0001_invariants.sql. They are NOT optional polish: each one is a case where application
// code alone would let a legally wrong row exist. See the header of that file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------------------------
// Vocabulary
// ---------------------------------------------------------------------------------------------

/// One shared vocabulary (docs/03 §ActionType). NOT all of these are rights requests:
/// ROBINSON and EINMELDUNG_FRAUD have no Art. 12(3) clock and no Art. 77 remedy, so they
/// materialise as SuppressionEnrolment / FraudMarkerFiling, never as a RightsRequest.
enum ActionType {
  OBJECTION_ART21
  ACCESS_ART15
  ACCESS_ART15_SOURCE
  ERASURE_ART17
  ROBINSON
  EINMELDUNG_FRAUD
}

/// RightsRequest.requestType is constrained to these four by a CHECK constraint (see migration).
enum StatutoryRequestType {
  OBJECTION_ART21
  ACCESS_ART15
  ACCESS_ART15_SOURCE
  ERASURE_ART17
}

enum RequestState {
  DRAFT
  BLOCKED_IDENTITY
  READY
  SENT
  AWAITING_RESPONSE_PROVISIONAL
  AWAITING_RESPONSE
  AWAITING_REGISTERED_RESEND
  RESPONSE_RECEIVED
  NEEDS_HUMAN
  COMPLIED
  INCOMPLETE
  REFUSED
  ESCALATION_DRAFTED
  ESCALATED
  CLOSED_FAILED
  WITHDRAWN
}

enum Outcome {
  COMPLIED
  INCOMPLETE
  REFUSED
  NO_RESPONSE
  /// The user declined the registered re-send. EXCLUDED from controller compliance stats: no
  /// provable clock ever ran, so the silence is not evidence of non-compliance (docs/05 §6).
  NO_PROVABLE_CLOCK
  WITHDRAWN
  ABANDONED
}

enum RequestCause {
  USER_INITIATED
  PROVENANCE_CHAIN
  FRAUD_REPAIR
}

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  EXPIRED
}

enum IdentityMethod {
  BANK_IDENT
  EID
}

enum ControllerType {
  CREDIT_BUREAU
  ADDRESS_TRADER
  DIRECTORY
  ECOMMERCE
  OTHER
  /// docs/10 §7: B2B people-data / contact-enrichment brokers (ZoomInfo, Apollo, Lusha, Cognism,
  /// People Data Labs, RocketReach) that scrape LinkedIn/Xing and sell professional profiles.
  /// NOTE: these follow OTHER so the declared order matches the migration's ADD VALUE append order.
  DATA_ENRICHMENT_BROKER
  /// Applicant-tracking / HCM systems (Workday, SAP SuccessFactors, Personio…). Usually a PROCESSOR
  /// for the employer — the removal route is a request to the employer, not to the vendor.
  HR_TECH
  /// AI hiring/screening tools (HireVue, Retorio, Pymetrics…) — Art. 22 automated-decision exposure.
  AI_SCREENER
  /// Background-screening firms (HireRight, Sterling, First Advantage…).
  SCREENING
}

enum ControllerRole {
  BUREAU
  BROKER
  DIRECTORY
  /// docs/10 §7: a data-enrichment broker. Instrument is Art. 17 + Art. 21(1), NOT the Art. 21(2)
  /// marketing objection — this processing is sales/recruiting intelligence, not direct marketing.
  ENRICHMENT_BROKER
  /// An HR-tech vendor acting as processor for an employer; the controller is the employer.
  EMPLOYER_PROCESSOR
}

enum ChannelMode {
  email
  web_form
  postal
}

enum Actor {
  SYSTEM
  USER
  HUMAN_OPS
}

enum EvidenceKind {
  OUTBOUND_COPY
  SCREENSHOT
  POSTAL_PROOF
  RESPONSE_COPY
}

enum IdentityPacketKind {
  REDACTED_ID_COPY
  NONE
}

// ---------------------------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------------------------

/// Who may reach the ops review queue (port wave 5, ADR-037). Deliberately NOT a request header:
/// ops routes read every user's request ledger — a map of who is exercising rights against whom,
/// which is exactly the targeting signal CLAUDE.md's one rule exists to suppress — and they file
/// Art. 77 complaints in a user's name. That is a stored property of a principal, not a claim a
/// caller makes about itself.
enum UserRole {
  USER
  HUMAN_OPS
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  subscriptionStatus String   @default("none")
  role               UserRole @default(USER)
  createdAt          DateTime @default(now())

  /// Per-user envelope key material (CLAUDE.md §4). The DEK is sealed under a KEK the app does not
  /// store beside the data; `kekRef` names which KEK, so keys can rotate without re-reading rows.
  wrappedDek            Bytes?
  kekRef                String?

  /// --- Auth policy (port wave 3, ADR-035) ---------------------------------------------------
  /// When the second factor was enrolled. Null = enrolled but never confirmed.
  totpEnrolledAt        DateTime?
  /// The last TOTP counter accepted for this user. THE replay defence: a code at or below this is
  /// refused. Monotonic by trigger (0008) — rewinding it re-opens every code in between.
  totpLastCounter       BigInt?
  /// Password and second-factor throttle budgets are SEPARATE on purpose. A password lockout is
  /// triggerable by anyone who knows the email; sharing one budget would let a stranger lock the
  /// account holder out of their own authenticator. See packages/core/src/auth/session.ts.
  failedLoginCount      Int      @default(0)
  lastFailedLoginAt     DateTime?
  failedMfaCount        Int      @default(0)
  lastFailedMfaAt       DateTime?

  identity              Identity?
  mandates              Mandate[]
  rightsRequests        RightsRequest[]
  suppressionEnrolments SuppressionEnrolment[]
  fraudMarkerFilings    FraudMarkerFiling[]
  provenanceLedgers     ProvenanceLedger[]
  authCredential        AuthCredential?
  sessions              Session[]
  recoveryCodes         RecoveryCode[]
  creditFileSnapshots   CreditFileSnapshot[]
}

/// THE SAFETY KEYSTONE. Every RightsRequest's subject identifiers are snapshotted from here and
/// never free-typed. There is no column anywhere that holds a subject name typed by a user.
model Identity {
  id          String          @id @default(cuid())
  userId      String          @unique
  status      IdentityStatus  @default(UNVERIFIED)
  method      IdentityMethod?
  /// Encrypt at rest with a per-user envelope key (docs/03 retention section).
  legalName   String?
  dateOfBirth DateTime?
  verifiedAt  DateTime?
  providerRef String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses           IdentityAddress[]
  packet              IdentityPacket?
  creditFileSnapshots CreditFileSnapshot[]
}

model IdentityAddress {
  id         String   @id @default(cuid())
  identityId String
  street     String
  postalCode String
  city       String
  country    String   @default("DE")
  /// Exactly one current address per identity — enforced by a partial unique index in the migration.
  /// Zero means an empty "Anschrift" line goes out in a legal letter; more than one means the
  /// renderer picks arbitrarily.
  current    Boolean  @default(false)
  verifiedAt DateTime

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

/// The docs/08 Tier-2 "pre-verified identity packet" (audit C6). Three templates promise a redacted
/// ID enclosure; without this entity nothing could produce one and the letters asserted an enclosure
/// they did not carry.
model IdentityPacket {
  id                String             @id @default(cuid())
  identityId        String             @unique
  kind              IdentityPacketKind
  redactionProfile  String
  /// Segregated, envelope-encrypted store; key gated on step-up auth (docs/06 C2).
  storageRef        String?
  sha256            String
  generatedAt       DateTime           @default(now())
  expiresAt         DateTime?
  sourceProviderRef String?
  lastAttachedAt    DateTime?

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
}

model Mandate {
  id              String                 @id @default(cuid())
  userId          String
  /// Which request types this authorisation covers.
  scope           StatutoryRequestType[]
  qesSignatureRef String
  documentHash    String
  signedAt        DateTime
  revokedAt       DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rightsRequests RightsRequest[]

  @@index([userId])
}

/// The census — the moat.
model Controller {
  id                       String          @id @default(cuid())
  slug                     String          @unique
  legalName                String
  type                     ControllerType
  role                     ControllerRole?
  country                  String          @default("DE")
  /// Competent supervisory authority for an Art. 77 complaint. Mirrors the playbook seatDpa enum.
  seatDpa                  String?
  namesSourcesInArt14      Boolean         @default(false)
  art15SourceRouteVerified Boolean         @default(false)
  legalBasisNotes          String?
  identityProofRequired    String?
  responseNormDays         Int?

  playbooks           Playbook[]
  rightsRequests      RightsRequest[]
  provenanceLedgers   ProvenanceLedger[]
  fraudMarkerFilings  FraudMarkerFiling[]
  creditFileSnapshots CreditFileSnapshot[]
}

model Playbook {
  id           String     @id @default(cuid())
  controllerId String
  slug         String
  requestType  ActionType
  version      Int
  active       Boolean    @default(false)
  /// The parsed YAML. schema/playbook.schema.json is normative and is validated on load.
  document     Json
  createdAt    DateTime   @default(now())

  controller     Controller      @relation(fields: [controllerId], references: [id])
  rightsRequests RightsRequest[]

  /// Never mutate a shipped version (docs/04). The uniqueness is the audit key.
  @@unique([slug, version])
  @@index([controllerId])
}

// ---------------------------------------------------------------------------------------------
// The ticket
// ---------------------------------------------------------------------------------------------

model RightsRequest {
  id           String               @id @default(cuid())
  userId       String
  controllerId String
  playbookId   String
  mandateId    String?
  requestType  StatutoryRequestType
  state        RequestState         @default(DRAFT)
  cause        RequestCause         @default(USER_INITIATED)

  channel    ChannelMode
  /// Was THIS dispatch a registered (Einwurf-Einschreiben) send?
  registered Boolean     @default(false)

  sentAt                  DateTime?
  /// Operational scheduling hint from a non-provable send. NEVER a statutory deadline, never shown
  /// to a controller or a DPA as one (CLAUDE.md §6). Separate column so no query can confuse them.
  provisionalDeadlineAt   DateTime?
  /// The Art. 12(3) clock. A CHECK constraint enforces: non-null ONLY if provableSendConfirmedAt is.
  deadlineAt              DateTime?
  provableSendConfirmedAt DateTime?
  closedAt                DateTime?
  outcome                 Outcome?

  /// Idempotency (audit C3): sha256(userId|controllerId|requestType|cycleOrdinal), UNIQUE.
  /// The cycle dimension is what permits the provenance follow-up chain, the resend path, and
  /// lawful annual Art. 15 re-access — a bare unique triple would forbid all three.
  cycleOrdinal   Int    @default(1)
  idempotencyKey String @unique

  supersedesRequestId String?
  createdAt           DateTime @default(now())

  user         User            @relation(fields: [userId], references: [id])
  controller   Controller      @relation(fields: [controllerId], references: [id])
  playbook     Playbook        @relation(fields: [playbookId], references: [id])
  mandate      Mandate?        @relation(fields: [mandateId], references: [id])
  supersedes   RightsRequest?  @relation("RequestChain", fields: [supersedesRequestId], references: [id])
  supersededBy RightsRequest[] @relation("RequestChain")

  events           RequestEvent[]
  responses        ControllerResponse[]
  evidence         EvidenceRecord[]
  provenanceLedger ProvenanceLedger?
  inboundDocuments InboundDocument[]

  @@index([userId, controllerId, requestType])
  @@index([state])
  @@index([deadlineAt])
}

/// Append-only. No updates, no deletes — corrections are new rows (enforced by triggers).
model RequestEvent {
  id        String        @id @default(cuid())
  requestId String
  type      String
  fromState RequestState?
  toState   RequestState
  actor     Actor
  payload   Json?
  createdAt DateTime      @default(now())

  request RightsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// A document that arrived without knowing which request it answers (port wave 5, ADR-037).
///
/// Phase-0 inbound correlation is HUMAN (docs/04). A controller's reply quotes our reference, or a
/// letter arrives in the post, and a person decides which request it belongs to. That decision is
/// never derived from the document's own content: a hostile PDF asserting "this answers request X"
/// would otherwise be able to close a stranger's statutory request. The columns below record who
/// decided and when, and 0011 refuses an assignment that names neither.
model InboundDocument {
  id          String      @id @default(cuid())
  receivedAt  DateTime
  channel     ChannelMode
  /// As received. A correlation HINT for a human, never trusted to name a subject or a request.
  senderRef   String
  subjectLine String?
  storageRef  String
  sha256      String
  /// CLAUDE.md §4: a retained raw reference with no purge date is an open-ended retention.
  purgeRawAt  DateTime

  assignedRequestId String?
  assignedAt        DateTime?
  /// The HUMAN_OPS principal who correlated it. Attribution is the point (CLAUDE.md §2).
  assignedByUserId  String?
  createdAt         DateTime @default(now())

  /// NoAction is stated rather than inherited — leaving it implicit is how this file and the
  /// database came to disagree (0012). Prisma's default for an optional relation is SetNull, which
  /// `inbound_assignment_is_attributed` makes impossible: the FK can null only this column, and the
  /// CHECK forbids that half-state. Deleting a request therefore FAILS while a document points at
  /// it, so an erasure must purge the document first rather than orphan its raw reference.
  assignedRequest RightsRequest? @relation(fields: [assignedRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assignedRequestId])
  @@index([receivedAt])
}

model ControllerResponse {
  id              String      @id @default(cuid())
  requestId       String
  receivedAt      DateTime
  channel         ChannelMode
  /// Purged after the normalisation window (docs/03 retention, CLAUDE.md §4). A raw reference
  /// without a scheduled purge is a retention violation waiting to happen, so 0005 enforces
  /// `rawDocumentRef IS NULL OR purgeRawAt IS NOT NULL` at the database.
  rawDocumentRef  String?
  purgeRawAt      DateTime?
  /// Parser output. ADVISORY ONLY — may never drive an irreversible transition below the confidence
  /// threshold or without human review (docs/06 C4).
  structured      Json
  parseConfidence Float
  reviewedByHuman Boolean     @default(false)

  request RightsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// Was this anchor issued by a qualified trust service provider, or by a dev/sandbox stand-in?
/// ADR-037: a POSTAL_PROOF anchor is one of the two facts that authorise `provableSendConfirmed`,
/// so the distinction has to survive in the row — not just in the process that wrote it.
enum AnchorKind {
  QUALIFIED
  SIMULATED
}

/// Tamper-evident. A hash chain proves integrity; only the QTSP anchor proves time.
model EvidenceRecord {
  id                    String       @id @default(cuid())
  requestId             String
  kind                  EvidenceKind
  sha256                String
  prevHash              String?
  chainHash             String       @unique
  qualifiedTimestampRef String?
  /// Non-null exactly when qualifiedTimestampRef is (CHECK in 0010). Never inferred from the ref.
  anchorKind            AnchorKind?
  storageRef            String
  createdAt             DateTime     @default(now())

  request RightsRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ---------------------------------------------------------------------------------------------
// Provenance (the flagship) — docs/09
// ---------------------------------------------------------------------------------------------

model ProvenanceLedger {
  id              String   @id @default(cuid())
  userId          String
  controllerId    String
  rightsRequestId String   @unique
  createdAt       DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id])
  controller Controller        @relation(fields: [controllerId], references: [id])
  request    RightsRequest     @relation(fields: [rightsRequestId], references: [id], onDelete: Cascade)
  entries    ProvenanceEntry[]

  @@index([userId, controllerId])
}

model ProvenanceEntry {
  id                   String  @id @default(cuid())
  ledgerId             String
  dataCategory         String
  statedSource         String?
  statedLegalBasis     String?
  isBroker             Boolean @default(false)
  matchedWatchlistSlug String?
  confidence           Float
  evidenceRecordId     String?

  ledger ProvenanceLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId])
}

// ---------------------------------------------------------------------------------------------
// Non-statutory actions (audit H3) — no Art. 12(3) clock, no Art. 77 route
// ---------------------------------------------------------------------------------------------

model SuppressionProgram {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  jurisdiction  String
  channel       ChannelMode
  renewalMonths Int?

  enrolments SuppressionEnrolment[]
}

model SuppressionEnrolment {
  id         String    @id @default(cuid())
  userId     String
  programId  String
  state      String
  enrolledAt DateTime  @default(now())
  expiresAt  DateTime?

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  program SuppressionProgram @relation(fields: [programId], references: [id])

  @@unique([userId, programId])
}

/// The Schufa Identitätsbetrug-Einmeldung victim marker. A guided filing, not a demand.
/// It does NOT affect the score — do not present it as if it does (docs/05 §3).
model FraudMarkerFiling {
  id               String    @id @default(cuid())
  userId           String
  controllerId     String
  state            String
  filedAt          DateTime?
  identityPacketId String?
  evidenceRecordId String?
  confirmedAt      DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  controller Controller @relation(fields: [controllerId], references: [id])

  @@index([userId])
}

/// Tier telemetry (docs/08). Every user-visible action writes exactly one row, including failures —
/// under-reporting cost corrupts the only metric that steers spend.
model LeverageAction {
  id               String    @id @default(cuid())
  userId           String
  controllerId     String?
  tier             String
  mechanism        String
  costCents        Int       @default(0)
  outcome          String
  /// ADR-036: which rung was taken and why every other candidate was rejected (typed reasons, e.g.
  /// HIGH_HARM_CONTROLLER_TYPE, TIER_CANNOT_ACHIEVE_OUTCOME). Non-personal by construction — outcome,
  /// tiers, mechanisms and route refs only. Nullable: rows predating the ladder have no reason to give.
  routingDecision  Json?
  verifiedAt       DateTime?
  evidenceRecordId String?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([tier, mechanism])
}

/// The docs/08 Tier-1 "self-serve route directory" (specced in docs/08 §2, built in docs/10 §7 for the
/// enrichment-broker layer). The cheapest rung: use the company's own deletion / opt-out page rather
/// than a legal letter — there is nothing for them to refuse. Cheapest-rung-first routing prefers a
/// matching route over generating a RightsRequest (docs/08 guardrail 5).
///
/// GUARDRAIL (docs/08 guardrail 1, non-negotiable): this entity holds NO third-party credential. A route
/// with `requiresLogin = true` stays a GUIDED HANDOFF — we deep-link the user into their own session and
/// they act; we never store their password or log in for them. There is deliberately no password/token/
/// cookie column here, and packages/core asserts that absence in a test.
model SelfServeRoute {
  id                 String             @id @default(cuid())
  /// The controller this route belongs to (Controller.slug). Not an FK: a route may exist for a company
  /// before it is imported into the census, and the census import reconciles by slug.
  companySlug        String
  routeType          SelfServeRouteType
  /// The public opt-out / deletion / preference URL. Deep-linked in a guided handoff.
  url                String
  /// Ordered, human-readable steps the user follows (rendered as a checklist). Not executable code.
  steps              String[]
  /// True where the route requires signing into the company's account. Such routes stay GUIDED — never
  /// automated, never credential-storing (docs/08 guardrail 1).
  requiresLogin      Boolean            @default(false)
  estMinutes         Int?
  /// Staleness kills this asset — a broken link starts nothing. A re-check job updates this (docs/08 §2).
  lastVerifiedAt     DateTime?
  verificationMethod String?
  /// Rolling success rate, for cheapest-rung routing and honest reporting.
  successRate        Float?
  createdAt          DateTime           @default(now())

  @@index([companySlug])
  @@index([companySlug, routeType])
}

/// The kinds of self-serve off-switch a company exposes (docs/08 §2). DSR_ERASURE is the enrichment-
/// broker "remove me" form (e.g. ZoomInfo's removal page, Apollo's Privacy Center) — a genuine GDPR
/// erasure route, distinct from a mere US-style DO_NOT_SELL suppression.
enum SelfServeRouteType {
  ACCOUNT_DELETION
  MARKETING_PREFS
  DO_NOT_SELL
  AD_ID_RESET
  CONSENT_WITHDRAWAL
  DSR_ERASURE
}

/// -----------------------------------------------------------------------------------------------
/// Auth (docs/01 P0: email + TOTP MFA). Secrets sit apart from User so the auth surface audits in
/// isolation. The identity-verification gate is UNTOUCHED by auth: a fresh account's Identity stays
/// UNVERIFIED and every rights-request route keeps 403ing until the ident provider (stubbed in the
/// alpha) marks it VERIFIED — auth authenticates a person to their account, never to a subject.
/// TODO(security): envelope-encrypt totpSecret at rest alongside Identity PII (docs/03).
model AuthCredential {
  userId       String   @id
  /// scrypt, self-describing format: scrypt$N$r$p$saltB64$hashB64
  passwordHash String
  /// RFC 6238 TOTP secret, base32, SEALED under the user's DEK (CLAUDE.md §4 — see
  /// packages/core/src/crypto/envelope.ts). Never stored in plaintext: a database dump must not
  /// hand an attacker the second factor. Ported in wave 1 from the pre-audit line's ADR D20.
  totpSecretEnc Bytes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id          String    @id @default(cuid())
  /// sha256 hex of the bearer token — the raw token never touches the database.
  tokenHash   String    @unique
  userId      String
  /// False until the TOTP step succeeds; guarded routes require a fully-verified session.
  /// Kept in step with `mfaCompletedAt` by CHECK session_mfa_flags_agree (0008).
  mfaVerified Boolean   @default(false)
  createdAt   DateTime  @default(now())
  /// Last request this session made. The idle timeout (30 min) decides on THIS, not on createdAt —
  /// absolute TTL alone cannot express "a tab left open on a shared laptop stops being signed in".
  lastSeenAt  DateTime  @default(now())
  /// When the second factor was presented. A timestamp, not a flag, because the policy is about
  /// freshness. NULL = the session is authenticated for nothing but completing the challenge.
  mfaCompletedAt DateTime?
  /// When the second factor was RE-confirmed to open high-sensitivity data (docs/06 C2). Guarded by
  /// CHECK session_stepup_requires_mfa: step-up without MFA is unrepresentable.
  stepUpAt    DateTime?
  expiresAt   DateTime
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use MFA recovery codes (docs/06 C2, ADR-035). Shown ONCE at enrolment, stored hashed.
/// Single use is enforced by the `recovery_code_single_use` trigger (0008), not by application
/// discipline: an "if (code.usedAt) reject" is one early return away from being wrong, and a
/// concurrent double-submit would spend one code twice.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  /// sha256 hex of the normalised code. The plaintext is never persisted anywhere.
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// -----------------------------------------------------------------------------------------------
/// BYO-Datenkopie ingest (docs/10 §3.1/§3.2 P1.5) — the same-day-utility surface.
enum CreditFileSourceKind {
  UPLOAD
  RESPONSE
}

enum CreditFileEntryType {
  NEGATIVE_CLAIM
  CONTRACT
  INQUIRY
  ADDRESS
  INSOLVENCY
  SCORE
  OTHER
}

enum FindingSeverity {
  INFO
  UPCOMING
  OVERDUE
}

/// SAFETY (docs/10 §3.1, same class as IdentityPacket — the anti-stalker one rule): a snapshot is
/// bound to the VERIFIED identity whose parsed name+DOB matched the document. A document about
/// someone else must be UNREPRESENTABLE here: the API match-gate rejects+purges on mismatch, and the
/// 0003 trigger re-asserts (identity belongs to user, status VERIFIED) at every write. OQ-15 governs
/// the match thresholds; the raw upload is purged after normalisation (CLAUDE.md §4) — only the hash
/// stays.
model CreditFileSnapshot {
  id              String               @id @default(cuid())
  userId          String
  identityId      String
  controllerId    String
  sourceKind      CreditFileSourceKind
  receivedAt      DateTime             @default(now())
  matchAssertedAt DateTime
  parseConfidence Float
  rawDocumentHash String

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity   Identity          @relation(fields: [identityId], references: [id])
  controller Controller        @relation(fields: [controllerId], references: [id])
  entries    CreditFileEntry[]
  findings   FileFinding[]

  @@index([userId])
}

model CreditFileEntry {
  id          String              @id @default(cuid())
  snapshotId  String
  entryType   CreditFileEntryType
  /// Who reported the entry to the bureau (creditor / source), as parsed. Advisory.
  reportedBy  String?
  reportedAt  DateTime?
  settledAt   DateTime?
  amountCents Int?
  disputed    Boolean             @default(false)
  label       String?
  /// Full parser output for this entry — advisory only, never drives an irreversible action.
  raw         Json

  snapshot CreditFileSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  findings FileFinding[]

  @@index([snapshotId])
}

/// Deterministic rule-engine output. `ruleSetVersion` is load-bearing: rule sets are versioned,
/// effective-dated and counsel-signed like templates (docs/10 §3.2 P1.5, OQ-13); findings from an
/// unsigned rule set render as preliminary. Never a score promise (docs/05 §3).
model FileFinding {
  id                   String          @id @default(cuid())
  snapshotId           String
  entryId              String?
  ruleId               String
  ruleSetVersion       String
  severity             FindingSeverity
  computedDeadlineAt   DateTime?
  recommendedAction    String
  scoreRelevance       String?
  scoreNegativeWarning Boolean         @default(false)
  explanation          String
  createdAt            DateTime        @default(now())

  snapshot CreditFileSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  entry    CreditFileEntry?   @relation(fields: [entryId], references: [id])

  @@index([snapshotId])
}
